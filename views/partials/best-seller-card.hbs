<a href="/personalizar/{{slug}}?lista=mas-vendidos" class="card-best card-interactiva">
    <div class="card-imagen">
        <img class="img-principal" src="{{imagen}}" alt="{{nombre}}">
        <img class="img-hover" src="{{imagenHover}}" alt="{{nombre}} personalizado">
        <div class="card-overlay">
            <span class="overlay-titulo">Arma tu pedido</span>
            <span class="overlay-btn">Personalizar</span>
        </div>
    </div>
    <div class="product-info">
        <h3>{{nombre}}</h3>
        <p class="price">RD${{precio}}</p>
    </div>
</a>
